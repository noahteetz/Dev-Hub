POSTGRES_DB=devhub
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub

# Encrypts the GitHub and GitLab tokens stored in the database.
# Without it Dev Hub still runs, but no token can be saved.
# Generate one with: openssl rand -base64 32
# Keep it out of version control and back it up with the database; a dump without
# this key cannot be restored into a working token store.
DEVHUB_ENCRYPTION_KEY=
