POSTGRES_DB=devhub
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub

# Encrypts the GitHub and GitLab tokens stored in the database.
# Without it Dev Hub still runs, but no token can be saved.
# Generate one with: openssl rand -base64 32
# Keep it out of version control and back it up with the database; a dump without
# this key cannot be restored into a working token store.
DEVHUB_ENCRYPTION_KEY=

# Keycloak. Left off for local development: the stack then starts without an
# identity provider and the API is open, which is fine on localhost and wrong
# anywhere else. Set it to true and fill in the realm to try the real login —
# the frontend client already allows http://localhost:5173.
DEVHUB_AUTH_ENABLED=false
DEVHUB_AUTH_ISSUER_URI=https://auth.teammegabyte.net/realms/dev-hub
DEVHUB_AUTH_CLIENT_ID=dev-hub-frontend
DEVHUB_AUTH_AUDIENCE=dev-hub-backend
DEVHUB_AUTH_REQUIRED_ROLE=devhub-user
