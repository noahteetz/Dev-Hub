# Copy to /home/noahteetz/dev-hub/.env on the server and fill in real values.
# chmod 600 it — it holds the database password and the token encryption key.

POSTGRES_DB=devhub
POSTGRES_USER=devhub
# openssl rand -base64 24
POSTGRES_PASSWORD=

# Encrypts the stored GitHub and GitLab tokens. Back it up together with the
# database; a dump restored without this key has an unreadable token store.
# openssl rand -base64 32
DEVHUB_ENCRYPTION_KEY=

# Enable explicitly after following deploy/REMOTE_WORKSPACES.md.
DEVHUB_WORKSPACE_ENABLED=false
COMPOSE_PROFILES=
# openssl rand -hex 32 (must also be identical on the backend and runner)
DEVHUB_RUNNER_TOKEN=
# Runner-wide limit across all users.
WORKSPACE_MAX_RUNNING=2
# Per user: running at once, and kept in total (running + stopped).
WORKSPACE_MAX_RUNNING_PER_USER=2
WORKSPACE_MAX_PER_USER=3
WORKSPACE_CPUS=2
WORKSPACE_MEMORY_BYTES=4294967296
# Measured budget, not a filesystem-enforced quota.
WORKSPACE_DISK_BYTES=5368709120
RUNNER_MIN_FREE_BYTES=10737418240
WORKSPACE_IDLE_SECONDS=1800
WORKSPACE_MAX_RUNTIME_SECONDS=14400
