# Copy to /home/noahteetz/dev-hub/.env on the server and fill in real values.
# chmod 600 it — it holds the database password and the token encryption key.

POSTGRES_DB=devhub
POSTGRES_USER=devhub
# openssl rand -base64 24
POSTGRES_PASSWORD=

# Encrypts the stored GitHub and GitLab tokens. Back it up together with the
# database; a dump restored without this key has an unreadable token store.
# openssl rand -base64 32
DEVHUB_ENCRYPTION_KEY=
