{
  "name": "dev-hub",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "backend\\gradlew.bat -p backend bootRun",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "backend\\gradlew.bat -p backend build",
    "build:frontend": "npm --prefix frontend run build",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs --follow"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}